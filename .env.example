# ===== 大模型 =====
# chat 模型：DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.3
# embedding 模型：阿里云百炼（DashScope 工作空间域名，2026 年起兼容端点需要业务空间前缀）
# 获取方式：百炼控制台 → 业务空间管理 → API Host（形如 ws-xxxx.cn-beijing.maas.aliyuncs.com）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://<你的业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ===== RAG =====
RAG_TOP_K=4
RAG_THRESHOLD=0.35
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80

# ===== 钉钉（留空 = IM 禁用，应用照常启动）=====
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ===== 服务 =====
SERVER_PORT=8080
